# PostgreSQL Database Configuration
# NOTE: The values below are example placeholders and NOT operational credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=postgres
POSTGRES_TEST_DB=test_db

# Security Credentials
# JWT_SECRET must be a cryptographically strong random secret (e.g. 256-bit base64)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars

# INTERNAL_API_KEY protects inter-service internal communication
INTERNAL_API_KEY=replace_with_a_secure_internal_api_key
